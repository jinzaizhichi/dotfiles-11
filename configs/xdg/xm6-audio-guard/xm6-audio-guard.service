[Unit]
Description=Mute fallback audio when the Sony XM6 disconnects
After=pipewire-pulse.service wireplumber.service
Wants=pipewire-pulse.service wireplumber.service

[Service]
ExecStart=/usr/bin/bash %h/.config/xm6-audio-guard/watch.sh
Restart=always
RestartSec=1

[Install]
WantedBy=default.target
