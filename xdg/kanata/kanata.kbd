(defcfg
    process-unmapped-keys yes
    log-layer-changes no
)

(defsrc
    esc
    caps
    lshift
    rshift
    grv
    spc
)

(deflayer default
    caps
    esc
    @oshift
    @oshift
    grv
    @space-ctrl
)

(defalias
    ;; Space: tap = space, hold = Ctrl
    space-ctrl
    (tap-hold-press 150 150 spc lctl)

    ;; Single tap Shift = one-shot Shift
    shift-os
    (tap-hold-release
        200
        200
        (one-shot 2000 lsft)
        lsft
    )

    ;; Double tap Shift = Caps Word
    shift-cw
    (caps-word 2000)

    ;; Shift behavior
    oshift
    (tap-dance 250 (@shift-os @shift-cw))
)

;; Swap ` and ~
(defoverrides
    (grv) (lsft grv)
    (lsft grv) (grv)
)
